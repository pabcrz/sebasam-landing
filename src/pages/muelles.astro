---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactActions from "../components/ContactActions.astro";
import BusinessHours from "../components/BusinessHours.astro";
import {
  autoRepairJsonLd,
  business,
  muelles,
  muellesServiceJsonLd,
} from "../content/business";

const title = muelles.title;
const description = muelles.description;
---

<BaseLayout
  title={title}
  description={description}
  pathname="/muelles"
  jsonLd={[muellesServiceJsonLd("/muelles"), autoRepairJsonLd("/muelles")]}
>
  <Header />
  <main id="contenido">
    <section class="section">
      <div class="container split-heading">
        <div>
          <p class="eyebrow">Especialistas en muelles</p>
          <h1 class="section-title">Servicio de muelles</h1>
        </div>
        <div class="hero-copy">
          <p class="section-copy">{muelles.intro}</p>
          <ContactActions />
        </div>
      </div>
    </section>

    <section class="section section--compact">
      <div class="container split-heading">
        <div>
          <p class="eyebrow">Qué incluye</p>
          <h2 class="section-title">
            Trabajo completo sobre los muelles de tu unidad.
          </h2>
        </div>
        <p class="section-copy">
          Revisamos la altura, la tensión y el estado de cada hoja. Enderezamos,
          reforzamos o cambiamos lo necesario, y explicamos cada opción antes de
          avanzar.
        </p>
      </div>
      <div class="container service-rail">
        {
          muelles.includes.map((item, index) => (
            <article class="service-card surface">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item}</h3>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--dark">
      <div class="container units-layout">
        <div>
          <p class="eyebrow">Unidades atendidas</p>
          <h2 class="section-title">
            Muelles para todo el transporte de trabajo.
          </h2>
          <p class="section-copy">{business.vehicleExamples}</p>
        </div>
        <ul class="unit-list" aria-label="Tipos de unidades atendidas">
          {business.vehicles.map((vehicle) => <li><span>{vehicle}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="section section--compact">
      <div class="container story surface">
        <p class="eyebrow">Por qué SEBASAM</p>
        <h2 class="section-title">{business.trustMessage}</h2>
        <p class="section-copy">{business.trustExplanation}</p>
      </div>
    </section>

    <section class="section">
      <div class="container split-heading">
        <div>
          <p class="eyebrow">Preguntas frecuentes</p>
          <h2 class="section-title">Dudas comunes sobre muelles.</h2>
        </div>
      </div>
      <div class="container faq-list">
        {
          muelles.faqs.map((item) => (
            <details class="faq-item surface">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section id="contacto" class="section contact-section">
      <div class="container contact-layout">
        <div>
          <p class="eyebrow">Contacto</p>
          <h2 class="section-title">Cotizá tu servicio de muelles.</h2>
          <p class="section-copy">
            Mandá un mensaje por WhatsApp con el modelo de tu unidad y empezá
            hoy mismo.
          </p>
          <ContactActions />
        </div>
        <aside class="contact-card surface">
          <h3>Datos del taller</h3>
          <p>{business.address.display}</p>
          <BusinessHours />
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .split-heading,
  .units-layout,
  .contact-layout {
    display: grid;
    gap: 2rem;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .service-rail {
    display: grid;
    grid-auto-columns: minmax(210px, 76vw);
    grid-auto-flow: column;
    gap: 1rem;
    margin-top: 2rem;
    overflow-x: auto;
    padding-block: 0.25rem 1rem;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .service-card {
    min-height: 132px;
    padding: 1rem;
    scroll-snap-align: start;
  }

  .service-card span {
    color: var(--color-blue-600);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .service-card h3 {
    margin: 1.75rem 0 0;
    color: var(--color-navy-900);
    font-size: clamp(1.15rem, 3vw, 1.45rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .section--dark {
    background: linear-gradient(145deg, var(--color-navy-900), var(--color-navy-800));
    color: var(--color-white);
  }

  .section--dark .section-title,
  .section--dark .section-copy {
    color: var(--color-white);
  }

  .section--dark .section-copy {
    opacity: 0.74;
  }

  .section--dark .eyebrow {
    color: #9dccff;
  }

  .unit-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .unit-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: center;
    min-height: 56px;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(157, 204, 255, 0.18);
    border-radius: var(--radius-lg);
    background: rgba(157, 204, 255, 0.08);
    color: var(--color-white);
    font-weight: 700;
  }

  .unit-list li::before {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: #9dccff;
    content: '';
  }

  .story {
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .faq-item {
    padding: 0 1.25rem;
  }

  .faq-item summary {
    min-height: 56px;
    cursor: pointer;
    color: var(--color-navy-900);
    font-size: 1.05rem;
    font-weight: 800;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    float: right;
    color: var(--color-blue-600);
    content: '+';
    font-size: 1.4rem;
    font-weight: 500;
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-item p {
    margin: 0;
    padding-bottom: 1.25rem;
    color: var(--color-slate-600);
    line-height: 1.65;
  }

  .contact-section {
    background: var(--color-slate-50);
  }

  .contact-card {
    display: grid;
    gap: 1rem;
    padding: clamp(1rem, 4vw, 1.5rem);
  }

  .contact-card h3 {
    margin: 0;
    font-size: 1.4rem;
  }

  .contact-card p {
    margin: 0;
    color: var(--color-slate-600);
    line-height: 1.6;
  }

  @media (min-width: 700px) {
    .service-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: row;
      overflow: visible;
      padding-block: 0;
      scroll-snap-type: none;
    }
  }

  @media (min-width: 960px) {
    .split-heading,
    .units-layout,
    .contact-layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    }

    .service-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
