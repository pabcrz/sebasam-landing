---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactActions from "../components/ContactActions.astro";
import BusinessHours from "../components/BusinessHours.astro";
import {
  autoRepairJsonLd,
  business,
  muelles,
  muellesServiceJsonLd,
} from "../content/business";

const title = muelles.title;
const description = muelles.description;
---

<BaseLayout
  title={title}
  description={description}
  pathname="/muelles"
  jsonLd={[muellesServiceJsonLd("/muelles"), autoRepairJsonLd("/muelles")]}
>
  <Header />
  <main id="contenido">
    <section class="section" style="padding-block: clamp(1.5rem, 4vw, 3rem) 0">
      <div class="container split-heading">
        <div class="muelles-hero">
          <div>
            <h1 class="section-title">Servicio de muelles</h1>
          </div>
          <img
            class="muelles-logo"
            src="/brand/sebasam-logo-light-680.png"
            srcset="/brand/sebasam-logo-light-192.png 192w, /brand/sebasam-logo-light-680.png 680w"
            sizes="(max-width: 680px) 100vw, 680px"
            alt={business.brand}
            width="520"
            height="220"
          />
        </div>
        <div class="hero-copy">
          <p class="section-copy">{muelles.intro}</p>
          <ContactActions />
        </div>
      </div>
    </section>

    <section class="section section--compact">
      <div class="container">
        <p class="eyebrow">Qué incluye</p>
        <h2 class="section-title">Trabajos y refacciones para muelles.</h2>
      </div>
      <div class="container service-rail">
        {
          muelles.includes.map((item, index) => (
            <article class="service-card surface">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item}</h3>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="container split-heading">
        <div>
          <p class="eyebrow">Preguntas frecuentes</p>
          <h2 class="section-title">Dudas comunes sobre muelles.</h2>
        </div>
      </div>
      <div class="container faq-list">
        {
          muelles.faqs.map((item) => (
            <details class="faq-item surface">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section id="contacto" class="section contact-section">
      <div class="container contact-layout">
        <div>
          <p class="eyebrow">Contacto</p>
          <h2 class="section-title">Cotizá tu servicio de muelles.</h2>
          <p class="section-copy">
            Mandá un mensaje por WhatsApp con el modelo de tu unidad y empezá
            hoy mismo.
          </p>
          <ContactActions />
        </div>
        <aside class="contact-card surface">
          <h3>Datos del taller</h3>
          <p>{business.address.display}</p>
          <BusinessHours />
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .split-heading,
  .contact-layout {
    display: grid;
    gap: 0.5rem;
  }

  .muelles-hero {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 4vw, 0.5rem);
  }

  .muelles-logo {
    display: block;
    width: min(100%, 520px);
    height: auto;
    filter: drop-shadow(0 22px 42px rgba(0, 43, 104, 0.12));
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .service-rail {
    display: grid;
    grid-auto-columns: minmax(210px, 76vw);
    grid-auto-flow: column;
    gap: 1rem;
    margin-top: 2rem;
    overflow-x: auto;
    padding-block: 0.25rem 1rem;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .service-card {
    min-height: 132px;
    padding: 1rem;
    scroll-snap-align: start;
  }

  .service-card span {
    color: var(--color-blue-600);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .service-card h3 {
    margin: 1.75rem 0 0;
    color: var(--color-navy-900);
    font-size: clamp(1.15rem, 3vw, 1.45rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .faq-item {
    padding: 1.25rem;
  }

  .faq-item summary {
    cursor: pointer;
    color: var(--color-navy-900);
    font-size: 1.05rem;
    font-weight: 800;
    list-style: none;
    transition: color 180ms ease;
  }

  .faq-item[open] summary {
    color: var(--color-blue-700);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    float: right;
    color: var(--color-blue-600);
    content: "+";
    font-size: 1.4rem;
    font-weight: 500;
  }

  .faq-item[open] summary::after {
    content: "−";
  }

  .faq-item p {
    margin: 0;
    padding: 1.25rem 0;
    color: var(--color-slate-600);
    line-height: 1.65;
  }

  .faq-item[open] p {
    animation: faq-reveal 220ms ease;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-section {
    background: var(--color-slate-50);
  }

  .contact-card {
    display: grid;
    gap: 1rem;
    padding: clamp(1rem, 4vw, 1.5rem);
  }

  .contact-card h3 {
    margin: 0;
    font-size: 1.4rem;
  }

  .contact-card p {
    margin: 0;
    color: var(--color-slate-600);
    line-height: 1.6;
  }

  @media (min-width: 700px) {
    .service-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: row;
      overflow: visible;
      padding-block: 0;
      scroll-snap-type: none;
    }
  }

  @media (min-width: 960px) {
    .split-heading,
    .contact-layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    }

    .service-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
